# Copy to .env.local for local development. Never commit real secret keys.

# Clerk — https://dashboard.clerk.com → your app → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Stripe (TEST mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally, or the webhook endpoint's signing secret in production
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Owner-only /stats dashboard: your Google account email(s), comma-separated
ADMIN_EMAILS=you@gmail.com

# Optional (Cloud Run): Google Analytics 4 measurement id for visitor stats
NEXT_PUBLIC_GA_ID=

# Optional: OpenAlex API key (free at openalex.org) for a higher daily quota on the focus pages' paper feeds
OPENALEX_API_KEY=
